{
  "programme": {
    "id": "ai-engineering-2026",
    "title": "AI Engineering",
    "subtitle": "An indie degree",
    "learner": "gtfoo",
    "opened": "2026-08-12",
    "framing": "transcript",
    "framing_note": "Degree-rigorous internally — blocks, credits, prerequisites, capstone. The public artifact is a transcript with evidence tiers and linked artifacts, never a diploma. Rendering is a template choice; nothing here depends on it.",
    "credit_unit": "1 credit ≈ 20 hours of work",
    "total_credits": 51,
    "pacing": "irregular",
    "pacing_note": "Hours vary week to week. Progress is banked and monotonic — no streaks, nothing destroyable by a quiet month. Projected completion is a range derived from logged hours, never from intended hours.",
    "ordering_principle": "Value-weighted within prerequisite constraints. Stopping at any point should leave the highest-value skills already banked, so an unfinished programme is still a gain.",
    "total_hours": 944,
    "public_log": "Every course publishes, but into one growing public engineering log rather than six standalone posts. A reader arrives once and finds a body of work that compounds; six separate write-ups fragment the same effort into things nobody finishes. Each course contributes a chapter that must stand alone on its own page and must also connect backwards to at least one earlier chapter's result.",
    "total_optional_hours": 5,
    "optional_note": "Optional items are duplicates of work an earlier course already required. They are kept rather than deleted, because a second pass is sometimes what makes a thing land — but the programme total counts required work only, and completion never waits for them.",
    "brand_note": "Indie Degree is the platform; this instance is an indie MSc in AI engineering. Indie carries the same meaning it does in film and games — produced outside the institution, deliberately, and judged on the work rather than on who signed it off."
  },
  "blocks": [
    {
      "id": "block-1",
      "title": "Applied AI Engineering",
      "purpose": "The employable core. Closes the distance to applied and field AI roles, where the gap read already puts the learner at 94%.",
      "credits": 23
    },
    {
      "id": "block-2",
      "title": "Depth",
      "purpose": "What makes this a programme rather than a certificate. Builds the models rather than calling them.",
      "credits": 28
    }
  ],
