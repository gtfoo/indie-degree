# Where progress is stored. Must be OUTSIDE the app tree in production; the
# app throws rather than guessing. /home/deploy/indie-degree-data on the box.
DATA_DIR=

# Sign-in is entirely optional. Without it the app runs read-only: the
# transcript is still public, and nobody — including you — can tick anything
# off. That is a supported state, not a broken one.

# The one address permitted to sign in and write. No default on purpose: a
# hardcoded address would mean a forked deployment trusts this repository's
# author rather than its own operator.
OWNER_EMAIL=

# Auth.js needs this even to READ a session. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# The PUBLIC origin, and required in production.
#
# The app listens on 127.0.0.1:3003 behind Caddy, so Auth.js sees the internal
# host on every request. Without this it can build the callback into the magic
# link from that internal address — producing a link that arrives looking
# perfectly normal and goes nowhere. 1 Percent More Fluent sets this for the
# same reason on the same box.
AUTH_URL=https://indie-degree.gtfoo.com

# Magic-link delivery. https://resend.com
AUTH_RESEND_KEY=
# Must be a domain VERIFIED in Resend. A subdomain is a separate domain there
# and needs its own DNS records; sending from an unverified one fails silently,
# and the only symptom is that no email ever arrives.
AUTH_EMAIL_FROM=login@example.com
